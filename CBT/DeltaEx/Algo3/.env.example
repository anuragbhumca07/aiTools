# ── Recommended: ONE server, both accounts (UI picks Demo or Live) ──────────
# Copy to .env.local and run start.ps1. Demo keys work only on testnet; Live
# keys only on production (and the Live key needs the server's public IPv4
# whitelisted on Delta: Account -> API Management). Find it: curl -4 https://api.ipify.org
DELTA_DEMO_API_KEY=your_demo_key_here
DELTA_DEMO_API_SECRET=your_demo_secret_here
DELTA_LIVE_API_KEY=your_live_key_here
DELTA_LIVE_API_SECRET=your_live_secret_here
DEFAULT_SYMBOL=BTCUSD
PORT=3011

# ── Optional: password-protect the app (recommended before exposing publicly) ─
# Set ACCESS_PASSWORD to require HTTP Basic Auth on everything except /health.
# Leave unset for open local use.
ACCESS_USER=admin
ACCESS_PASSWORD=

# ── Alternative: single account per server (start-demo.ps1 / start-prod.ps1) ─
# Copy to .env.demo (testnet) or .env.prod (production) instead:
#   DELTA_HOST=cdn-ind.testnet.deltaex.org   # or api.india.delta.exchange
#   DELTA_API_KEY=your_api_key_here
#   DELTA_API_SECRET=your_api_secret_here

# Copy to .env.demo (testnet) or .env.prod (production) and fill in your keys.
# Demo keys only work on the testnet host; real keys only on the production host.
#
#   Demo/testnet : DELTA_HOST=cdn-ind.testnet.deltaex.org
#   Production   : DELTA_HOST=api.india.delta.exchange   (default if unset)
#
# Production keys additionally require your public IPv4 to be whitelisted on the
# Delta API key (Account → API Management). Find it with: curl -4 https://api.ipify.org
DELTA_HOST=cdn-ind.testnet.deltaex.org
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here
DEFAULT_SYMBOL=BTCUSD
PORT=3011

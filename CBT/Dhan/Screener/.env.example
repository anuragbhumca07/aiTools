# ── Dhan API credentials ──────────────────────────────────────────────────────
# Get from your Dhan account → API Access → Generate Token
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# ── NIFTY index (VERIFY: correct security_id for NIFTY 50 on Dhan) ───────────
NIFTY_SECURITY_ID=13
NIFTY_EXCHANGE_SEG=IDX_I

# ── Universe filters ──────────────────────────────────────────────────────────
MIN_PRICE=50            # ₹ minimum stock price
MIN_ADTV_CR=10          # Minimum avg daily traded value in ₹ Crore
MAX_INSTRUMENTS=50      # 0 = full universe; keep ≤100 for Phase 1 test

# ── Data history ──────────────────────────────────────────────────────────────
HISTORY_DAYS_CAL=420    # Calendar days of daily OHLCV to cache

# ── Output ────────────────────────────────────────────────────────────────────
TOP_N=5                 # Top N long + Top N short picks per scan

# ── Timezone ──────────────────────────────────────────────────────────────────
TIMEZONE=Asia/Kolkata

# ── Cache paths ───────────────────────────────────────────────────────────────
CACHE_DIR=cache

# ── API rate limiting (VERIFY: against actual Dhan limits) ───────────────────
HIST_REQUEST_DELAY=0.35   # Seconds between historical data requests
HIST_MAX_RETRIES=3

# ── Market regime thresholds (UNVALIDATED — Phase 3 will tune these) ─────────
REGIME_BULL_THRESH=0.5
REGIME_BEAR_THRESH=-0.5

# ── Risk sizing ───────────────────────────────────────────────────────────────
ATR_RISK_MULTIPLIER=0.8   # Risk = 0.8 × ATR(14)

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=5050

# ─────────────────────────────────────────────────────────────────────────────
# SCORING WEIGHTS — ALL UNVALIDATED PLACEHOLDERS
# Phase 3 backtesting will replace every value below.
# Do NOT use scanner output for real trading until Phase 3 is complete.
# ─────────────────────────────────────────────────────────────────────────────
W_OPENING_RANGE_BREAKOUT=20
W_RELATIVE_VOLUME=15
W_VWAP_POSITION=10
W_MOMENTUM_5MIN=10
W_PREV_DAY_HL_BREAK=10
W_EMA_STRUCTURE=8
W_LEVEL_BREAKOUT=8
W_RS_NIFTY=7
W_SECTOR_RS=5
W_CANDLE_QUALITY=4
W_GAP_QUALITY=3

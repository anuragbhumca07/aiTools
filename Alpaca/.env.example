# ── Broker ────────────────────────────────────────────────────────────────────
BROKER=alpaca          # alpaca | robinhood
MODE=paper             # paper | live

# ── Alpaca (paper account) ────────────────────────────────────────────────────
ALPACA_KEY=your-alpaca-key-id
ALPACA_SECRET=your-alpaca-secret-key
# Base URL is auto-set from MODE but can be overridden:
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Strategy tuning (optional — defaults are in config.py) ───────────────────
# SCAN_TOP_N=20
# MAX_CONCURRENT=15
# CAPITAL_CAP_USD=500
# PORTFOLIO_RISK_CAP_PCT=0.06
# RISK_PER_TRADE_PCT=0.015
# STOP_ATR_MULT=2.5
# CANDLE_INTERVAL=5Min
# CANDLE_HISTORY_DAYS=6

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5100
